# "mock" (default, offline deterministic data) or "http" (calls the Finance API)
VITE_DATA_PROVIDER=mock
# Base URL of the Finance API (npm run server). In dev, Vite proxies /api to localhost:8787.
# Never put provider API keys in VITE_* variables; keep them on the server.
VITE_API_BASE_URL=/api
# Finance API port (server only)
PORT=8787
